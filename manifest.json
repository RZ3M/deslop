{
  "manifest_version": 3,
  "name": "Deslop — slop filter for X & LinkedIn",
  "short_name": "Deslop",
  "version": "0.1.0",
  "description": "Hides engagement bait, AI-written slop, recycled news and posts from countries you choose on X and LinkedIn. Powered by Jev.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Deslop",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://openrouter.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/x-main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/common.js", "src/content/x.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content/common.js", "src/content/linkedin.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
